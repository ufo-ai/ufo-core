{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "ufo/kit",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "ufo/kit": ["./src/apps/kit.ts"],
      "ufo/kit/jsx-runtime": ["./src/apps/kit.ts"],
      "@/*": ["./src/*"],
      "@brand/*": ["../../../assets/brand/*"]
    },
    "types": ["vite/client"]
  },
  "files": [
    "../../app_artifacts/ufo_ext_app_artifacts/skills/app-artifacts-home/app.tsx",
    "../../app_chat/ufo_ext_app_chat/skills/app-chat-home/app.tsx",
    "../../app_code/ufo_ext_app_code/skills/app-code-home/app.tsx",
    "../../app_issues/ufo_ext_app_issues/skills/app-issues-home/app.tsx",
    "../../app_meetings/ufo_ext_app_meetings/skills/app-meetings-home/app.tsx",
    "../../app_metrics/ufo_ext_app_metrics/skills/app-metrics-home/app.tsx",
    "../../app_radar/ufo_ext_app_radar/skills/app-radar-home/app.tsx",
    "../../app_wiki/ufo_ext_app_wiki/skills/app-wiki-home/app.tsx"
  ]
}
