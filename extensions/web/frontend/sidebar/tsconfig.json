{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/App": ["./src/App.tsx"],
      "@/*": ["../src/*"],
      "@brand/*": ["../../../../assets/brand/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/App.tsx",
    "src/main.tsx",
    "tests",
    "vite.config.ts"
  ]
}
