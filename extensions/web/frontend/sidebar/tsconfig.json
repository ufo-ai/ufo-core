{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/App": ["./src/App.tsx"],
      "@/components/Sidebar": ["./src/components/Sidebar.tsx"],
      "@/lib/rail": ["./src/lib/rail.ts"],
      "@/lib/railStore": ["./src/lib/railStore.ts"],
      "@/lib/route": ["./src/lib/route.ts"],
      "@/lib/router": ["./src/lib/router.ts"],
      "@/lib/title": ["./src/lib/title.ts"],
      "@/views/Agents": ["./src/views/Agents.tsx"],
      "@/views/Apps": ["./src/views/Apps.tsx"],
      "@/views/FirstRun": ["./src/views/FirstRun.tsx"],
      "@/views/Spotlight": ["./src/views/Spotlight.tsx"],
      "@/views/Store": ["./src/views/Store.tsx"],
      "@/*": ["../src/*"],
      "@brand/*": ["../../../../assets/brand/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/App.tsx",
    "src/main.tsx",
    "src/components/Sidebar.tsx",
    "src/lib/rail.ts",
    "src/lib/railStore.ts",
    "src/lib/route.ts",
    "src/lib/router.ts",
    "src/lib/title.ts",
    "src/views/Agents.tsx",
    "src/views/Apps.tsx",
    "src/views/FirstRun.tsx",
    "src/views/Spotlight.tsx",
    "src/views/Store.tsx",
    "tests",
    "vite.config.ts"
  ]
}
