#!/usr/bin/env python3
"""sbx — in-sandbox egress CLI.

The one credentialed egress a sandbox script gets: the Anthropic Messages API, reached through the
egress proxy. The sandbox holds only the sentinel key (ANTHROPIC_API_KEY) and dials out through the
HTTP(S)_PROXY the carrier sets, trusting the proxy CA (SSL_CERT_FILE, or the container trust store);
the proxy swaps the sentinel for the real key on the wire, so the raw credential never enters the
sandbox. Connectors are not reachable here — they execute server-side through the broker, never in
the sandbox."""

from __future__ import annotations

import argparse
import base64
import http.client
import json
import os
import ssl
import sys
from urllib.parse import urlsplit

ANTHROPIC_URL = "https://api.anthropic.com/v1/messages"
ANTHROPIC_VERSION = "2023-06-01"
DEFAULT_MODEL = "claude-opus-4-8"
DEFAULT_MAX_TOKENS = 1024


class SbxError(RuntimeError):
    pass


def ssl_context() -> ssl.SSLContext | None:
    cert_file = os.environ.get("SSL_CERT_FILE")
    if not cert_file:
        return None
    return ssl.create_default_context(cafile=cert_file)


def proxy_connection(target: str) -> http.client.HTTPSConnection:
    parsed = urlsplit(target)
    host = parsed.hostname or ""
    port = parsed.port or 443
    proxy = os.environ.get("HTTPS_PROXY") or os.environ.get("https_proxy") or ""
    if not proxy:
        return http.client.HTTPSConnection(host, port, context=ssl_context())
    # An https target through an http proxy: connect plainly to the proxy, CONNECT with the run
    # token as Proxy-Authorization, then TLS to the target (the proxy MITMs it with a cert our
    # SSL_CERT_FILE CA trusts). urllib drops proxy-URL userinfo on CONNECT, so we tunnel by hand.
    p = urlsplit(proxy if "//" in proxy else f"//{proxy}")
    connection = http.client.HTTPSConnection(
        p.hostname or "", p.port or 8888, context=ssl_context()
    )
    tunnel_headers = {}
    if p.username:
        credential = base64.b64encode(f"{p.username}:".encode()).decode()
        tunnel_headers["Proxy-Authorization"] = f"Basic {credential}"
    connection.set_tunnel(host, port, tunnel_headers)
    return connection


def post_json(url: str, headers: dict[str, str], body: dict[str, object]) -> dict[str, object]:
    payload = json.dumps(body).encode()
    path = urlsplit(url).path or "/"
    connection = proxy_connection(url)
    try:
        connection.request(
            "POST", path, body=payload, headers={"content-type": "application/json", **headers}
        )
        response = connection.getresponse()
        raw = response.read()
        status = response.status
    finally:
        connection.close()
    if status != 200:
        raise SbxError(f"{url} -> {status}: {raw.decode('utf-8', 'replace')}")
    decoded = json.loads(raw)
    if not isinstance(decoded, dict):
        raise SbxError(f"{url} returned non-object JSON: {raw.decode('utf-8', 'replace')}")
    return decoded


def require_env(name: str) -> str:
    value = os.environ.get(name)
    if not value:
        raise SbxError(f"{name} is required in the sandbox environment")
    return value


def anthropic_text(response: dict[str, object]) -> str:
    blocks = response.get("content")
    if not isinstance(blocks, list):
        raise SbxError(f"anthropic response has no content array: {response!r}")
    parts = [
        block["text"]
        for block in blocks
        if isinstance(block, dict)
        and block.get("type") == "text"
        and isinstance(block.get("text"), str)
    ]
    return "".join(parts)


def cmd_llm(args: argparse.Namespace) -> str:
    body = {
        "model": args.model,
        "max_tokens": args.max_tokens,
        "messages": [{"role": "user", "content": args.prompt}],
    }
    headers = {
        "x-api-key": require_env("ANTHROPIC_API_KEY"),
        "anthropic-version": ANTHROPIC_VERSION,
    }
    return anthropic_text(post_json(ANTHROPIC_URL, headers, body))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="sbx", description="in-sandbox egress CLI")
    subcommands = parser.add_subparsers(dest="command", required=True)

    llm = subcommands.add_parser("llm", help="call the Anthropic Messages API")
    llm.add_argument("--model", default=DEFAULT_MODEL)
    llm.add_argument("--max-tokens", type=int, default=DEFAULT_MAX_TOKENS, dest="max_tokens")
    llm.add_argument("prompt")
    llm.set_defaults(func=cmd_llm)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        sys.stdout.write(args.func(args))
        sys.stdout.write("\n")
    except SbxError as error:
        sys.stderr.write(f"sbx: {error}\n")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
