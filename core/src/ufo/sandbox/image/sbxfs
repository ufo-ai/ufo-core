class FsError(RuntimeError):
    pass


def _has_binary_extension(path: Path) -> bool:
    return path.suffix.lower() in BINARY_EXTENSIONS


def _is_binary(path: Path) -> bool:
    if _has_binary_extension(path):
        return True
    try:
        with path.open("rb") as handle:
            return b"\x00" in handle.read(BINARY_SNIFF_BYTES)
    except OSError:
        return True


def _read_text(path: Path) -> str:
    return path.read_text("utf-8", errors="replace")


def _split_lines(text: str) -> list[str]:
    return text.split("\n")


def _cap_line(line: str) -> str:
    if len(line) <= LINE_CHAR_CAP:
        return line
    return f"{line[:LINE_CHAR_CAP]}... [+{len(line) - LINE_CHAR_CAP} chars]"


def _number_lines(lines: list[str], start: int, width: int) -> list[str]:
    return [f"{number:>{width}}\t{_cap_line(line)}" for number, line in enumerate(lines, start)]


def _read_image(path: Path) -> dict:
    """The extension routes here; the bytes decide the media type. A model provider validates
    image bytes against the declared type, so a mislabeled file (PDF bytes in a `.png`, a JPEG
    saved as `.png`) must surface as a recoverable error or the corrected type here — shipping
    the extension's claim fails the whole model request downstream."""
    size = path.stat().st_size
    if size > IMAGE_MAX_BYTES:
        raise FsError(
            f"{path} is {size} bytes; over the {IMAGE_MAX_BYTES}-byte image read cap. "
            "Resize it (e.g. with a bash tool) before reading."
        )
    data = path.read_bytes()
    media_type = _image_media_type(data)
    if media_type is None:
        raise FsError(
            f"{path} has an image extension but its bytes are not png/jpeg/gif/webp "
            f"(they start with {data[:8]!r}). Re-export it as a real image, then read it again."
        )
    return {
        "path": str(path),
        "type": "image",
        "media_type": media_type,
        "data": base64.b64encode(data).decode("ascii"),
        "size_bytes": size,
    }


def _image_media_type(data: bytes) -> str | None:
    for media_type, magic in IMAGE_MAGIC:
        if data.startswith(magic):
            return media_type
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return "image/webp"
    return None


def _pdf_total_pages(path: Path) -> int:
    proc = subprocess.run(["pdfinfo", str(path)], capture_output=True, text=True, check=False)
    if proc.returncode != 0:
        raise FsError(proc.stderr.strip() or f"pdfinfo exited {proc.returncode}")
    for line in proc.stdout.splitlines():
        if line.startswith("Pages:"):
            return int(line.split(":", 1)[1].strip())
    raise FsError(f"pdfinfo gave no page count for {path}")


def _pdf_text(path: Path, start: int, end: int) -> str:
    if shutil.which("pdftotext") is None:
        return ""
    proc = subprocess.run(
        ["pdftotext", "-f", str(start), "-l", str(end), str(path), "-"],
        capture_output=True,
        text=True,
        check=False,
    )
    return proc.stdout if proc.returncode == 0 else ""


def _pdf_pages(path: Path, start: int, end: int) -> list[dict]:
    with tempfile.TemporaryDirectory() as tmp:
        prefix = str(Path(tmp) / "page")
        proc = subprocess.run(
            [
                "pdftoppm",
                "-png",
                "-r",
                str(PDF_RENDER_DPI),
                "-f",
                str(start),
                "-l",
                str(end),
                str(path),
                prefix,
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        if proc.returncode != 0:
            raise FsError(proc.stderr.strip() or f"pdftoppm exited {proc.returncode}")
        pages = []
        for png in sorted(Path(tmp).glob("page*.png")):
            data = png.read_bytes()
            if len(data) > IMAGE_MAX_BYTES:
                raise FsError(
                    f"{path} page render is {len(data)} bytes; over the {IMAGE_MAX_BYTES}-byte "
                    f"image cap. Re-read a smaller page range or a lower-DPI export."
                )
            pages.append(
                {"media_type": "image/png", "data": base64.b64encode(data).decode("ascii")}
            )
        return pages


def _read_pdf(path: Path, offset: int, limit: int) -> dict:
    if shutil.which("pdfinfo") is None or shutil.which("pdftoppm") is None:
        return {
            "path": str(path),
            "type": "pdf",
            "text": _pdf_text(path, 1, PDF_DEFAULT_MAX_PAGES),
            "pages": [],
            "total_pages": None,
            "render_unavailable": True,
            "note": "page rendering requires poppler-utils",
        }
    total = _pdf_total_pages(path)
    start = min(max(offset, 1), max(total, 1))
    count = min(limit, PDF_DEFAULT_MAX_PAGES)
    end = min(start + count - 1, total)
    pages = _pdf_pages(path, start, end)
    returned = len(pages)
    next_page = start + returned if start + returned <= total else None
    return {
        "path": str(path),
        "type": "pdf",
        "text": _pdf_text(path, start, end),
        "total_pages": total,
        "start_page": start,
        "pages_returned": returned,
        "next_page": next_page,
        "pages": pages,
        "quality_reminder": PDF_QUALITY_REMINDER,
    }


def _read_pptx(path: Path, offset: int, limit: int) -> dict:
    """Render a presentation as slide images: convert it to pdf with LibreOffice into a temp dir,
    then reuse the pdf page-render path so the read returns extracted text plus one image per
    slide — the same shape as a pdf read, relabelled to slides. Absent soffice leaves a text-free
    note, mirroring the poppler-absent pdf branch."""
    if shutil.which("soffice") is None:
        return {
            "path": str(path),
            "type": "pptx",
            "pages": [],
            "total_pages": None,
            "render_unavailable": True,
            "note": "slide rendering requires libreoffice (soffice)",
        }
    with tempfile.TemporaryDirectory() as tmp:
        proc = subprocess.run(
            [
                "soffice",
                "--headless",
                f"-env:UserInstallation=file://{tmp}/profile",
                "--convert-to",
                "pdf",
                "--outdir",
                tmp,
                str(path),
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        pdf = Path(tmp) / f"{path.stem}.pdf"
        if proc.returncode != 0 or not pdf.exists():
            raise FsError(proc.stderr.strip() or f"soffice could not render {path}")
        result = _read_pdf(pdf, offset, limit)
    result["path"] = str(path)
    result["type"] = "pptx"
    return result


def op_read(params: dict) -> dict:
    path = Path(params["path"])
    offset = max(int(params.get("offset") or 1), 1)
    limit = int(params.get("limit") or READ_DEFAULT_LIMIT)
    if not path.exists():
        raise FsError(f"{path} not found")
    if path.is_dir():
        raise FsError(f"{path} is a directory")
    suffix = path.suffix.lower()
    if suffix in IMAGE_MEDIA_TYPES:
        return _read_image(path)
    if suffix == ".pdf":
        return _read_pdf(path, offset, limit)
    if suffix == ".pptx":
        return _read_pptx(path, offset, limit)
    if path.stat().st_size == 0:
        return {
            "path": str(path),
            "content": "",
            "total_lines": 0,
            "start_line": offset,
            "lines_returned": 0,
            "remaining_lines": 0,
            "next_offset": None,
            "truncated": False,
            "is_empty": True,
        }
    if _is_binary(path):
        raise FsError(f"{path} is a binary file")
    text = _read_text(path)
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    total = len(lines)
    window = lines[offset - 1 : offset - 1 + limit]
    returned = len(window)
    consumed = offset - 1 + returned
    remaining = max(total - consumed, 0)
    truncated = remaining > 0
    width = len(str(total))
    content = "\n".join(_number_lines(window, offset, width))
    return {
        "path": str(path),
        "content": content,
        "total_lines": total,
        "start_line": offset,
        "lines_returned": returned,
        "remaining_lines": remaining,
        "next_offset": consumed + 1 if remaining > 0 else None,
        "truncated": truncated,
        "is_empty": False,
    }


def _inside(path: Path, workspace: Path) -> bool:
    return path == workspace or workspace in path.parents


@contextmanager
def _file_target(params: dict, create_parent: bool = False):
    workspace = Path(params["workspace"]).resolve()
    path = Path(params["path"])
    if path.name in {"", ".", ".."}:
        raise FsError(f"{path} is not a file path")
    parent = path.parent.resolve()
    if not _inside(parent, workspace):
        raise FsError(f"{path} escapes {workspace}")
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    try:
        descriptor = os.open(workspace, flags)
    except OSError as error:
        raise FsError(str(error)) from error
    try:
        for part in parent.relative_to(workspace).parts:
            if create_parent:
                try:
                    os.mkdir(part, dir_fd=descriptor)
                except FileExistsError:
                    pass
            try:
                child = os.open(part, flags, dir_fd=descriptor)
            except FileNotFoundError as error:
                raise FsError(f"{path} not found") from error
            except OSError as error:
                raise FsError(str(error)) from error
            os.close(descriptor)
            descriptor = child
        yield parent / path.name, workspace, descriptor
    finally:
        os.close(descriptor)


def _regular_text(parent: int, path: Path, limit: int) -> str:
    descriptor = os.open(
        path.name,
        os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
        dir_fd=parent,
    )
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise OSError(f"{path} is not a regular file")
        with os.fdopen(descriptor, "r", encoding="utf-8", errors="replace") as handle:
            descriptor = -1
            return handle.read(limit)
    finally:
        if descriptor >= 0:
            os.close(descriptor)


@contextmanager
def _file_lock(path: Path):
    root = Path(tempfile.gettempdir()) / "ufo-sbxfs-locks"
    root.mkdir(mode=0o700, exist_ok=True)
    lock = root / hashlib.sha256(str(path).encode()).hexdigest()
    descriptor = os.open(lock, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def _existing_regular(parent: int, path: Path) -> os.stat_result | None:
    try:
        existing = os.stat(path.name, dir_fd=parent, follow_symlinks=False)
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(existing.st_mode):
        raise FsError(f"{path} is not a regular file")
    return existing


def _replace_text(parent: int, path: Path, text: str, mode: int) -> None:
    staged = f".ufo-edit-{uuid4().hex}"
    descriptor = os.open(
        staged,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        0o600,
        dir_fd=parent,
    )
    try:
        os.fchmod(descriptor, mode & 0o777)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            descriptor = -1
            handle.write(text)
        os.replace(staged, path.name, src_dir_fd=parent, dst_dir_fd=parent)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(staged, dir_fd=parent)
        except FileNotFoundError:
            pass


def _diff_lines(text: str | None) -> tuple[list[str], bool]:
    if text is None:
        return [], False
    bounded = text[:FILE_CHANGE_INPUT_MAX_CHARS]
    lines = bounded.splitlines(keepends=True)
    truncated = len(text) > FILE_CHANGE_INPUT_MAX_CHARS
    if len(lines) > FILE_CHANGE_INPUT_MAX_LINES:
        lines = lines[:FILE_CHANGE_INPUT_MAX_LINES]
        truncated = True
    return lines, truncated


def _file_change(
    before: str | None,
    after: str,
    truncated: bool = False,
) -> dict:
    before_lines, before_truncated = _diff_lines(before)
    after_lines, after_truncated = _diff_lines(after)
    patch_parts = []
    for line in difflib.unified_diff(
        before_lines,
        after_lines,
        fromfile="/dev/null" if before is None else "before",
        tofile="after",
        n=3,
        lineterm="\n",
    ):
        patch_parts.append(line)
        if line.startswith(("+", "-", " ")) and not line.endswith("\n"):
            patch_parts.append("\n\\ No newline at end of file\n")
    patch = "".join(patch_parts)
    return {
        "patch": patch[:FILE_CHANGE_PATCH_MAX_CHARS],
        "truncated": (
            truncated
            or before_truncated
            or after_truncated
            or len(patch) > FILE_CHANGE_PATCH_MAX_CHARS
        ),
    }


def _decode_text(encoded: object) -> str:
    if not isinstance(encoded, str):
        raise FsError("text must be base64 encoded")
    try:
        return base64.b64decode(encoded, altchars=b"-_", validate=True).decode(errors="replace")
    except (ValueError, binascii.Error) as error:
        raise FsError("text must be base64 encoded") from error


def op_write(params: dict) -> dict:
    with _file_target(params, create_parent=True) as (path, workspace, parent):
        with _file_target({"path": params["staged_path"], "workspace": params["workspace"]}) as (
            staged,
            staged_workspace,
            staged_parent,
        ):
            if staged_workspace != workspace:
                raise FsError("staged file is outside the workspace")
            if staged == path:
                raise FsError("staged file must differ from its target")
            try:
                with _file_lock(path):
                    existing = _existing_regular(parent, path)
                    if existing is not None and params.get("allow_existing") is not True:
                        raise FsError(f"file {path} must be read before it is written")
                    if _existing_regular(staged_parent, staged) is None:
                        raise FsError(f"{staged} not found")
                    before = (
                        None
                        if existing is None
                        else _regular_text(parent, path, FILE_CHANGE_INPUT_MAX_CHARS + 1)
                    )
                    after = _regular_text(staged_parent, staged, FILE_CHANGE_INPUT_MAX_CHARS + 1)
                    change = _file_change(before, after)
                    if existing is not None:
                        os.chmod(
                            staged.name,
                            existing.st_mode & 0o777,
                            dir_fd=staged_parent,
                            follow_symlinks=False,
                        )
                    os.replace(
                        staged.name,
                        path.name,
                        src_dir_fd=staged_parent,
                        dst_dir_fd=parent,
                    )
                    return {
                        "created": existing is None,
                        "change": change,
                    }
            finally:
                try:
                    os.unlink(staged.name, dir_fd=staged_parent)
                except FileNotFoundError:
                    pass


def _edit_list(params: dict) -> list[dict]:
    edits = params.get("edits")
    if not isinstance(edits, list) or not edits:
        raise FsError("edits must be a non-empty list")
    return [
        {
            "old_string": _decode_text(edit["old_string_b64"]),
            "new_string": _decode_text(edit["new_string_b64"]),
            "replace_all": bool(edit.get("replace_all")),
        }
        for edit in edits
    ]


def _apply_edit(text: str, edit: dict) -> tuple[str, int]:
    old = edit["old_string"]
    new = edit["new_string"]
    replace_all = bool(edit.get("replace_all"))
    count = text.count(old)
    if count == 0:
        raise FsError("old_string not found")
    if count > 1 and not replace_all:
        raise FsError(
            f"search text found {count} times. Provide more context or use replace_all=true."
        )
    return (text.replace(old, new), count) if replace_all else (text.replace(old, new, 1), 1)


def _edit_snippet(text: str, marker: str) -> str:
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    index = text.find(marker)
    if index < 0:
        hit_line, span = 0, 0
    else:
        hit_line = text[:index].count("\n")
        span = marker.count("\n")
    start = max(hit_line - EDIT_SNIPPET_CONTEXT, 0)
    end = min(hit_line + span + EDIT_SNIPPET_CONTEXT + 1, len(lines))
    width = len(str(max(end, 1)))
    return "\n".join(_number_lines(lines[start:end], start + 1, width))


def op_edit(params: dict) -> dict:
    with _file_target(params) as (path, _workspace, parent):
        with _file_lock(path):
            existing = _existing_regular(parent, path)
            if existing is None:
                raise FsError(f"{path} not found")
            edits = _edit_list(params)
            before = _regular_text(parent, path, existing.st_size + 1)
            text = before
            total = 0
            for edit in edits:
                text, count = _apply_edit(text, edit)
                total += count
            result = {
                "path": str(path),
                "message": f"{path}: {total} replacements",
                "replacements": total,
                "snippet": _edit_snippet(text, edits[0]["new_string"])[:EDIT_SNIPPET_MAX_CHARS],
                "change": _file_change(before, text),
            }
            _replace_text(parent, path, text, existing.st_mode)
            return result


def _walk(root: Path):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [name for name in dirnames if name not in SKIP_DIRS]
        for name in sorted(filenames):
            yield Path(dirpath) / name


