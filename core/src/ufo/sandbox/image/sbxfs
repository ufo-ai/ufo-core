def _grep_candidates(
    start: Path, root: Path, glob: str | None, type_name: str | None
) -> list[Path]:
    """The files a scan may read: everything under `start` that is a regular file inside `root` no
    symlink was crossed to reach. `os.walk` does not descend into a symlinked directory but does
    hand back symlinked files, and a scan that read one would return a host file's lines through a
    link the agent planted — the exact disclosure the guard exists to refuse."""
    walked = [start] if start.is_file() else list(_walk(start, root))
    files = [path for path in walked if is_contained_regular(path, root)]
    if glob:
        return [
            path
            for path in files
            if fnmatch.fnmatch(path.name, glob) or fnmatch.fnmatch(str(path), glob)
        ]
    if type_name:
        wanted = TYPE_EXTENSIONS.get(type_name, frozenset())
        return [path for path in files if path.suffix.lower() in wanted]
    return [path for path in files if path.suffix.lower() in TEXT_EXTENSIONS]


def _truncate_match_line(line: str) -> str:
    if len(line) <= GREP_LINE_CHAR_CAP:
        return line
    return f"{line[:GREP_LINE_CHAR_CAP]}... [+{len(line) - GREP_LINE_CHAR_CAP} chars]"


def _grep_context(params: dict) -> tuple[int, int]:
    context = int(params.get("context") or 0)
    before = int(params.get("before_context") or 0) or context
    after = int(params.get("after_context") or 0) or context
    return before, after


def _rg_argv(
    params: dict, start: Path, glob: str | None, before: int, after: int
) -> list[str] | None:
    rg = shutil.which("rg")
    if rg is None:
        return None
    argv = [rg, "--json", "-n"]
    if params.get("ignore_case"):
        argv.append("-i")
    if params.get("multiline"):
        argv.append("-U")
    if before:
        argv += ["-B", str(before)]
    if after:
        argv += ["-A", str(after)]
    if glob:
        argv += ["--glob", glob]
    type_name = params.get("type")
    if type_name:
        argv += ["-t", str(type_name)]
    argv += ["--", params["pattern"], str(start)]
    return argv


def _rg_run(argv: list[str]) -> list[dict]:
    proc = subprocess.run(argv, capture_output=True, text=True)
    if proc.returncode not in (0, 1):
        raise FsError(proc.stderr.strip() or f"rg exited {proc.returncode}")
    events: list[dict] = []
    for raw in proc.stdout.splitlines():
        if not raw:
            continue
        event = json.loads(raw)
        if isinstance(event, dict):
            events.append(event)
    return events


def _rg_contained(events: list[dict], root: Path) -> list[dict]:
    """The events about files the guard vouches for. Ripgrep skips a symlink it meets while walking
    by default, which is a third-party default rather than a check of ours — the same filter the
    stdlib walk's hits pass is applied to its results, so the two branches refuse the same files."""
    kept = []
    for event in events:
        data = event.get("data")
        raw = data.get("path") if isinstance(data, dict) else None
        if raw is None or is_contained_regular(Path(_rg_text(raw)), root):
            kept.append(event)
    return kept


def _rg_text(field: object) -> str:
    if isinstance(field, dict):
        text = field.get("text")
        if isinstance(text, str):
            return text
        return ""
    return field if isinstance(field, str) else ""


def _grep_rg(
    params: dict,
    start: Path,
    root: Path,
    glob: str | None,
    mode: str,
    head: int,
    before: int,
    after: int,
) -> dict:
    argv = _rg_argv(params, start, glob, before, after)
    if argv is None:
        raise FsError("rg unavailable")
    events = _rg_contained(_rg_run(argv), root)

    if mode == "files_with_matches":
        files: list[str] = []
        for event in events:
            if event.get("type") != "begin":
                continue
            files.append(_rg_text(event["data"]["path"]))
            if len(files) >= head:
                return {"files": files, "count": len(files), "truncated": True}
        return {"files": files, "count": len(files), "truncated": False}

    if mode == "count":
        counts: list[dict] = []
        for event in events:
            if event.get("type") != "end":
                continue
            stats = event["data"].get("stats", {})
            hit = int(stats.get("matched_lines") or stats.get("matches") or 0)
            if hit:
                counts.append({"file": _rg_text(event["data"]["path"]), "count": hit})
        return {"counts": counts, "total_matches": sum(c["count"] for c in counts)}

    return _rg_content(events, head, before, after)


def _rg_content(events: list[dict], head: int, before: int, after: int) -> dict:
    by_file_context: dict[str, dict[int, str]] = {}
    raw_matches: list[tuple[str, int, str]] = []
    for event in events:
        kind = event.get("type")
        if kind not in {"context", "match"}:
            continue
        data = event["data"]
        file = _rg_text(data["path"])
        line = data["line_number"]
        content = _truncate_match_line(_rg_text(data["lines"]).rstrip("\n"))
        if kind == "context":
            by_file_context.setdefault(file, {})[line] = content
        else:
            raw_matches.append((file, line, content))

    matches: list[dict] = []
    truncated = False
    for file, line, content in raw_matches:
        if len(matches) >= head:
            truncated = True
            break
        entry: dict = {"file": file, "line": line, "content": content}
        rows = [
            {"line": number, "content": text}
            for number, text in sorted(by_file_context.get(file, {}).items())
            if line - before <= number <= line + after and number != line
        ]
        if rows:
            entry["context"] = rows
        matches.append(entry)
    return {"matches": matches, "count": len(matches), "truncated": truncated}


def _grep_stdlib(
    params: dict,
    start: Path,
    root: Path,
    glob: str | None,
    mode: str,
    head: int,
    before: int,
    after: int,
) -> dict:
    flags = re.IGNORECASE if params.get("ignore_case") else 0
    if params.get("multiline"):
        flags |= re.DOTALL | re.MULTILINE
    try:
        regex = re.compile(params["pattern"], flags)
    except re.error as error:
        raise FsError(f"invalid regex: {error}") from error
    files = _grep_candidates(start, root, glob, params.get("type"))
    multiline = bool(params.get("multiline"))

    if mode == "files_with_matches":
        matched: list[str] = []
        for path in files:
            text = _contained_text(path, root)
            if text is None:
                continue
            hit = (
                regex.search(text)
                if multiline
                else any(regex.search(line) for line in text.split("\n"))
            )
            if hit:
                matched.append(str(path))
                if len(matched) >= head:
                    return {"files": matched, "count": len(matched), "truncated": True}
        return {"files": matched, "count": len(matched), "truncated": False}

    if mode == "count":
        counts: list[dict] = []
        total = 0
        for path in files:
            text = _contained_text(path, root)
            if text is None:
                continue
            hit = (
                len(regex.findall(text))
                if multiline
                else sum(1 for line in text.split("\n") if regex.search(line))
            )
            if hit:
                counts.append({"file": str(path), "count": hit})
                total += hit
        return {"counts": counts, "total_matches": total}

    matches: list[dict] = []
    for path in files:
        text = _contained_text(path, root)
        if text is None:
            continue
        lines = text.split("\n")
        for index, line in enumerate(lines):
            if not regex.search(line):
                continue
            entry: dict = {
                "file": str(path),
                "line": index + 1,
                "content": _truncate_match_line(line),
            }
            context_rows: list[dict] = []
            for offset in range(max(0, index - before), index):
                context_rows.append(
                    {"line": offset + 1, "content": _truncate_match_line(lines[offset])}
                )
            for offset in range(index + 1, min(len(lines), index + 1 + after)):
                context_rows.append(
                    {"line": offset + 1, "content": _truncate_match_line(lines[offset])}
                )
            if context_rows:
                entry["context"] = context_rows
            matches.append(entry)
            if len(matches) >= head:
                return {"matches": matches, "count": len(matches), "truncated": True}
    return {"matches": matches, "count": len(matches), "truncated": False}


def op_grep(params: dict) -> dict:
    """A scan is two ingresses, not one: the directory it starts from and every file it hands back.
    Both go through the guard — the start directory by descent, each hit by the enumeration filter
    and a read off a pinned parent fd — and so does the `glob`, which selects paths of its own. What
    ripgrep does with a link it meets while walking is its default, not our check, so its results are
    filtered by the same rule the stdlib walk's are.

    Whether `path` names one file or a directory to walk decides which guard it goes through, and
    that question is asked before either of them runs. It is asked of the guard's own rooting, so a
    relative name is read against the workspace and never against whatever the process holds as its
    cwd — a probe rooted elsewhere answers for one path while the guard then runs on another."""
    mode = params.get("output_mode") or "files_with_matches"
    if mode not in {"content", "files_with_matches", "count"}:
        raise FsError(f"invalid output_mode: {mode}")
    head = int(params.get("head_limit") or GREP_DEFAULT_HEAD)
    before, after = _grep_context(params)
    root = contained_root(params["workspace"])
    raw = params.get("path") or root
    named = rooted(raw, root)
    start = contained_regular(raw, root) if named.is_file() else contained_dir(raw, root)
    glob = params.get("glob")
    pattern = None if glob is None else contained_pattern(str(glob), root)
    if shutil.which("rg") is not None:
        return _grep_rg(params, start, root, pattern, mode, head, before, after)
    return _grep_stdlib(params, start, root, pattern, mode, head, before, after)


def op_glob(params: dict) -> dict:
    """Scoping the directory the walk starts from does not scope the pattern: an absolute pattern
    re-roots the walk and the scoped `path` is never consulted, so the guard answers both at once —
    the pattern is confined to the workspace and re-roots there rather than at the filesystem anchor.
    Hits are filtered the same way, since a non-recursive pattern can still name a path through a
    symlinked directory."""
    workspace = contained_root(params["workspace"])
    root, pattern = contained_glob(params["pattern"], params.get("path"), workspace)
    exclude_names = params.get("exclude_names", [])
    if not isinstance(exclude_names, list) or any(
        not isinstance(name, str) or not name or "/" in name or "\\" in name
        for name in exclude_names
    ):
        raise FsError("exclude_names must be a list of path component names")
    excluded = frozenset(exclude_names)
    hits = [
        path
        for path in root.glob(pattern)
        if not excluded.intersection(path.relative_to(workspace).parts)
        and is_contained_regular(path, workspace)
    ]
    hits.sort(key=lambda path: path.stat().st_mtime if path.exists() else 0.0, reverse=True)
    truncated = len(hits) > GLOB_MAX_RESULTS
    capped = hits[:GLOB_MAX_RESULTS]
    files = [
        {
            "path": str(path),
            "size": path.stat().st_size,
            "modified": path.stat().st_mtime,
        }
        for path in capped
    ]
    result: dict = {"files": files, "count": len(files), "truncated": truncated}
    if truncated:
        result["truncated_message"] = (
            f"showing {GLOB_MAX_RESULTS} of {len(hits)} matches; refine the pattern"
        )
    return result


OPS = {
    "read": op_read,
    "write": op_write,
    "edit": op_edit,
    "grep": op_grep,
    "glob": op_glob,
}


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if len(argv) != 2 or argv[0] not in OPS:
        sys.stderr.write(f"usage: sbxfs {{{'|'.join(OPS)}}} <json>\n")
        return 2
    try:
        params = json.loads(argv[1])
        if not isinstance(params, dict):
            raise FsError("params must be a JSON object")
        result = OPS[argv[0]](params)
    except RECOVERABLE_ERRORS as error:
        message = (
            str(error)
            if isinstance(error, FsError | ContainmentError)
            else f"{type(error).__name__}: {error}"
        )
        sys.stdout.write(json.dumps({"error": message}))
        return 1
    sys.stdout.write(json.dumps(result))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
