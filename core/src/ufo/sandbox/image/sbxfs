def _grep_candidates(root: Path, glob: str | None, type_name: str | None) -> list[Path]:
    files = [root] if root.is_file() else list(_walk(root))
    if glob:
        return [
            path
            for path in files
            if fnmatch.fnmatch(path.name, glob) or fnmatch.fnmatch(str(path), glob)
        ]
    if type_name:
        wanted = TYPE_EXTENSIONS.get(type_name, frozenset())
        return [path for path in files if path.suffix.lower() in wanted]
    return [path for path in files if path.suffix.lower() in TEXT_EXTENSIONS]


def _truncate_match_line(line: str) -> str:
    if len(line) <= GREP_LINE_CHAR_CAP:
        return line
    return f"{line[:GREP_LINE_CHAR_CAP]}... [+{len(line) - GREP_LINE_CHAR_CAP} chars]"


def _grep_context(params: dict) -> tuple[int, int]:
    context = int(params.get("context") or 0)
    before = int(params.get("before_context") or 0) or context
    after = int(params.get("after_context") or 0) or context
    return before, after


def _rg_argv(params: dict, before: int, after: int) -> list[str] | None:
    rg = shutil.which("rg")
    if rg is None:
        return None
    argv = [rg, "--json", "-n"]
    if params.get("ignore_case"):
        argv.append("-i")
    if params.get("multiline"):
        argv.append("-U")
    if before:
        argv += ["-B", str(before)]
    if after:
        argv += ["-A", str(after)]
    glob = params.get("glob")
    if glob:
        argv += ["--glob", glob]
    type_name = params.get("type")
    if type_name:
        argv += ["-t", str(type_name)]
    argv += ["--", params["pattern"], str(Path(params.get("path") or "."))]
    return argv


def _rg_run(argv: list[str]) -> list[dict]:
    proc = subprocess.run(argv, capture_output=True, text=True)
    if proc.returncode not in (0, 1):
        raise FsError(proc.stderr.strip() or f"rg exited {proc.returncode}")
    events: list[dict] = []
    for raw in proc.stdout.splitlines():
        if not raw:
            continue
        event = json.loads(raw)
        if isinstance(event, dict):
            events.append(event)
    return events


def _rg_text(field: object) -> str:
    if isinstance(field, dict):
        text = field.get("text")
        if isinstance(text, str):
            return text
        return ""
    return field if isinstance(field, str) else ""


def _grep_rg(params: dict, mode: str, head: int, before: int, after: int) -> dict:
    argv = _rg_argv(params, before, after)
    if argv is None:
        raise FsError("rg unavailable")
    events = _rg_run(argv)

    if mode == "files_with_matches":
        files: list[str] = []
        for event in events:
            if event.get("type") != "begin":
                continue
            files.append(_rg_text(event["data"]["path"]))
            if len(files) >= head:
                return {"files": files, "count": len(files), "truncated": True}
        return {"files": files, "count": len(files), "truncated": False}

    if mode == "count":
        counts: list[dict] = []
        for event in events:
            if event.get("type") != "end":
                continue
            stats = event["data"].get("stats", {})
            hit = int(stats.get("matched_lines") or stats.get("matches") or 0)
            if hit:
                counts.append({"file": _rg_text(event["data"]["path"]), "count": hit})
        return {"counts": counts, "total_matches": sum(c["count"] for c in counts)}

    return _rg_content(events, head, before, after)


def _rg_content(events: list[dict], head: int, before: int, after: int) -> dict:
    by_file_context: dict[str, dict[int, str]] = {}
    raw_matches: list[tuple[str, int, str]] = []
    for event in events:
        kind = event.get("type")
        if kind not in {"context", "match"}:
            continue
        data = event["data"]
        file = _rg_text(data["path"])
        line = data["line_number"]
        content = _truncate_match_line(_rg_text(data["lines"]).rstrip("\n"))
        if kind == "context":
            by_file_context.setdefault(file, {})[line] = content
        else:
            raw_matches.append((file, line, content))

    matches: list[dict] = []
    truncated = False
    for file, line, content in raw_matches:
        if len(matches) >= head:
            truncated = True
            break
        entry: dict = {"file": file, "line": line, "content": content}
        rows = [
            {"line": number, "content": text}
            for number, text in sorted(by_file_context.get(file, {}).items())
            if line - before <= number <= line + after and number != line
        ]
        if rows:
            entry["context"] = rows
        matches.append(entry)
    return {"matches": matches, "count": len(matches), "truncated": truncated}


def _grep_stdlib(params: dict, mode: str, head: int, before: int, after: int) -> dict:
    flags = re.IGNORECASE if params.get("ignore_case") else 0
    if params.get("multiline"):
        flags |= re.DOTALL | re.MULTILINE
    try:
        regex = re.compile(params["pattern"], flags)
    except re.error as error:
        raise FsError(f"invalid regex: {error}") from error
    root = Path(params.get("path") or ".")
    if not root.exists():
        raise FsError(f"{root} not found")
    files = _grep_candidates(root, params.get("glob"), params.get("type"))
    multiline = bool(params.get("multiline"))

    if mode == "files_with_matches":
        matched: list[str] = []
        for path in files:
            if _is_binary(path):
                continue
            text = _read_text(path)
            hit = (
                regex.search(text)
                if multiline
                else any(regex.search(line) for line in text.split("\n"))
            )
            if hit:
                matched.append(str(path))
                if len(matched) >= head:
                    return {"files": matched, "count": len(matched), "truncated": True}
        return {"files": matched, "count": len(matched), "truncated": False}

    if mode == "count":
        counts: list[dict] = []
        total = 0
        for path in files:
            if _is_binary(path):
                continue
            text = _read_text(path)
            hit = (
                len(regex.findall(text))
                if multiline
                else sum(1 for line in text.split("\n") if regex.search(line))
            )
            if hit:
                counts.append({"file": str(path), "count": hit})
                total += hit
        return {"counts": counts, "total_matches": total}

    matches: list[dict] = []
    for path in files:
        if _is_binary(path):
            continue
        lines = _read_text(path).split("\n")
        for index, line in enumerate(lines):
            if not regex.search(line):
                continue
            entry: dict = {
                "file": str(path),
                "line": index + 1,
                "content": _truncate_match_line(line),
            }
            context_rows: list[dict] = []
            for offset in range(max(0, index - before), index):
                context_rows.append(
                    {"line": offset + 1, "content": _truncate_match_line(lines[offset])}
                )
            for offset in range(index + 1, min(len(lines), index + 1 + after)):
                context_rows.append(
                    {"line": offset + 1, "content": _truncate_match_line(lines[offset])}
                )
            if context_rows:
                entry["context"] = context_rows
            matches.append(entry)
            if len(matches) >= head:
                return {"matches": matches, "count": len(matches), "truncated": True}
    return {"matches": matches, "count": len(matches), "truncated": False}


def op_grep(params: dict) -> dict:
    mode = params.get("output_mode") or "files_with_matches"
    if mode not in {"content", "files_with_matches", "count"}:
        raise FsError(f"invalid output_mode: {mode}")
    head = int(params.get("head_limit") or GREP_DEFAULT_HEAD)
    before, after = _grep_context(params)
    if shutil.which("rg") is not None:
        return _grep_rg(params, mode, head, before, after)
    return _grep_stdlib(params, mode, head, before, after)


def op_glob(params: dict) -> dict:
    pattern = params["pattern"]
    root = Path(params.get("path") or ".")
    if Path(pattern).is_absolute():
        root = Path(Path(pattern).anchor)
        pattern = str(Path(pattern).relative_to(root))
        if pattern == ".":
            raise FsError(f"pattern {params['pattern']!r} matches a directory root")
    if not root.exists():
        raise FsError(f"{root} not found")
    hits = [path for path in root.glob(pattern) if path.is_file()]
    hits.sort(key=lambda path: path.stat().st_mtime if path.exists() else 0.0, reverse=True)
    truncated = len(hits) > GLOB_MAX_RESULTS
    capped = hits[:GLOB_MAX_RESULTS]
    files = [
        {
            "path": str(path),
            "size": path.stat().st_size,
            "modified": path.stat().st_mtime,
        }
        for path in capped
    ]
    result: dict = {"files": files, "count": len(files), "truncated": truncated}
    if truncated:
        result["truncated_message"] = (
            f"showing {GLOB_MAX_RESULTS} of {len(hits)} matches; refine the pattern"
        )
    return result


OPS = {
    "read": op_read,
    "write": op_write,
    "edit": op_edit,
    "grep": op_grep,
    "glob": op_glob,
}


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if len(argv) != 2 or argv[0] not in OPS:
        sys.stderr.write(f"usage: sbxfs {{{'|'.join(OPS)}}} <json>\n")
        return 2
    try:
        params = json.loads(argv[1])
        if not isinstance(params, dict):
            raise FsError("params must be a JSON object")
        result = OPS[argv[0]](params)
    except (FsError, KeyError, ValueError) as error:
        message = str(error) if isinstance(error, FsError) else f"{type(error).__name__}: {error}"
        sys.stdout.write(json.dumps({"error": message}))
        return 1
    sys.stdout.write(json.dumps(result))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
