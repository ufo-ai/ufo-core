{
  "rules": [
    {
      "kind": "scope",
      "hosts": [
        "api.anthropic.com",
        "api.openai.com"
      ]
    },
    {
      "kind": "internet"
    },
    {
      "kind": "injection",
      "host": "api.anthropic.com",
      "header": "x-api-key",
      "sentinel": "UFO_SENTINEL_MODEL_KEY",
      "real": "sk-ant-real-key"
    },
    {
      "kind": "meter",
      "host": "api.anthropic.com",
      "dimension": "tokens"
    },
    {
      "kind": "service",
      "host": "registry.npmjs.org",
      "daemon_prefix": "/pkg/registry.npmjs.org"
    }
  ]
}
